PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/guide-photo-studio
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# Public address of the site, used in account emails (verify / reset links). e.g. https://guidephotostudio.com
SITE_URL=
# Customer login rate limits need the visitor's real IP. Behind Hostinger's proxy keep 1 (the production default).
TRUST_PROXY=
# Studio admin login (used by `npm run seed` to create the admin account)
ADMIN_EMAIL=admin@guidephotostudio.com
ADMIN_PASSWORD=change-me-now
# Use 0.0.0.0 in production / Docker
HOST=127.0.0.1

# --- Client gallery hosting subscription ---
# Free access period for new galleries (days)
GALLERY_FREE_DAYS=90
# Razorpay (Dashboard → Settings → API Keys). Without keys, dev runs in TEST payment mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → URL https://<domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Google Drive folder import (optional). Create an API key with the Google Drive API enabled.
GOOGLE_API_KEY=
