{
  "name": "babysteps-guide-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/src/index.js",
    "dev:all": "concurrently -n api,web -c magenta,cyan \"npm run dev:server\" \"vite --host 0.0.0.0\"",
    "setup": "npm install",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "start": "node server/start.cjs",
    "seed": "node server/src/seed.js",
    "preview": "vite preview",
    "deploy": "bash deploy/deploy.sh",
    "package": "bash deploy/package.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.12.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "vite": "^7.3.8"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "main": "server/start.cjs",
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "readdir-glob": "^4.0.0",
    "mongodb": "^7.9.1"
  }
}
