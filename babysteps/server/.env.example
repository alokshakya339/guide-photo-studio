# BabySteps server — copy to .env and fill in.
PORT=5060
# Use 0.0.0.0 on a hosting server so it accepts outside connections.
HOST=127.0.0.1
# Local MongoDB, or a MongoDB Atlas connection string in production.
MONGO_URI=mongodb://127.0.0.1:27017/babysteps
# Long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Admin account — created/updated automatically when the server starts
ADMIN_EMAIL=admin@babystepsbyguide.com
ADMIN_PASSWORD=change-me-now
# Website origins allowed to call the API (comma-separated). Not needed when the server serves the site itself.
CLIENT_ORIGIN=http://localhost:5180
# Where uploaded photos are stored: mongo (in the database — survives redeploys) or disk (server/uploads)
UPLOAD_STORAGE=mongo
# Free hosting days for new client galleries
GALLERY_FREE_DAYS=90
# Optional: Google API key to list photos inside shared Google Drive folders
GOOGLE_API_KEY=
# Public site address (share previews & sitemap). Optional; defaults to the request's host.
SITE_URL=
# Email alerts for new enquiries (optional). Brevo: SMTP key (xsmtpsib-…) + login, or API key (xkeysib-…)
BREVO_API_KEY=
BREVO_SMTP_LOGIN=
RESEND_API_KEY=
EMAIL_FROM=
# …or any SMTP server (e.g. a Hostinger mailbox)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
# AI blog drafts in the admin (optional) — key from console.anthropic.com
ANTHROPIC_API_KEY=
# Online gift-card payments (Razorpay → Account & Settings → API Keys). Use rzp_test_… keys while testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Razorpay → Webhooks, events payment.captured + order.paid, URL https://<your-domain>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2 — client-gallery photos upload straight from the admin's browser to R2 (recommended for production).
# Needs an R2 API token with Object Read & Write on the bucket, and a CORS rule on the bucket (see README → "Client gallery storage").
# Leave empty to keep the old behaviour (uploads saved in MongoDB / on disk).
STORAGE_BUCKET=
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PREFIX=babysteps-galleries
